{
  "name": "miti-monorepo",
  "private": true,
  "scripts": {
    "native": "pnpm run --filter expo-app dev:client",
    "start": "pnpm run --filter expo-app start",
    "web": "pnpm run --filter miti-web dev",
    "chrome": "pnpm run --filter miti-extension dev",
    "android": "pnpm run --filter expo-app android",
    "ios": "pnpm run --filter expo-app ios",
    "api": "pnpm run --filter api dev",
    "check-deps": "check-dependency-version-consistency .",
    "lint": "turbo lint",
    "format": "turbo format",
    "build": "turbo build"
  },
  "resolutions": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-refresh": "^0.14.0"
  },
  "devDependencies": {
    "biome": "^0.3.3",
    "check-dependency-version-consistency": "^4.1.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "ajv": "^8.12.0",
    "node-gyp": "^10.1.0",
    "prettier": "^3.2.5",
    "turbo": "^2.1.3",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.0.0",
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "bufferutil",
    "core-js",
    "es5-ext",
    "esbuild",
    "lmdb",
    "msgpackr-extract",
    "sharp",
    "workerd"
  ]
}
